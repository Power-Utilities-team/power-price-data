# secrets
_tools/.entsoe_key
*.env
secrets/

# environments / caches
_tools/.venv/
__pycache__/
*.pyc
.extracted/

# regenerated data (the Action rebuilds these) — but KEEP the frozen history
data/raw/
data/processed/*
!data/processed/master_fixed.parquet
!data/processed/capacity_fixed.parquet
outputs/
# ^ the whole build dir: generate.py rewrites it, and CI stages the shipped copies
#   into deliverables/ instead. Previously only some subdirs were listed, which left
#   deck_charts/, deck_img/, review_charts/ and the .pptx builds showing as untracked.

# local safety copies taken before a risky rebuild — the vault backup covers these
archive/pre-*/
# reference copies of superseded workbooks: keep the README explaining them, not the
# binaries (git history can rebuild any of them)
archive/reference-copies/*.xlsx

# legacy source deck (large, superseded by the built one)
pre-update_*.pptx

# local logs / scratch
_meta/fetch_*.log
_meta/fetch_run.log

# source deck (copyrighted, large)
*.docx

# macOS + local scratch/legacy
.DS_Store
_meta/fetch_log.txt
_tools/powerquery/

# wrangler build/state for the status-page worker
_tools/refresh-page/.wrangler/

# PRE-SURGERY WORKBOOK COPIES STAY LOCAL (2026-08-23). A commit on 19 Aug swept these two
# files, about 38 MB and 2.6 MB, towards a PUBLIC repo, and git keeps a blob for good. They
# are the archive-before-a-risky-move copies the vault convention wants on disk, not in
# history. Ignored so a later `git add -A` cannot do it by accident.
archive/workbook-pre-surgery-2026-08-06/

# The two hand-made reference workbooks the chart templates were extracted FROM
# (2026-08-25). The templates themselves are text in _tools/chart_templates/ and are
# what the build reads; these are kept locally as provenance, not as a build input.
archive/extra-charts-base-2026-08-25/

# The UpSlide-linked workbook and anything derived from it. This repository is PUBLIC and
# that file is classified RAndCoInternalParent by the firm's own Microsoft sensitivity
# labelling, quite apart from naming a colleague, an internal file server and two paths to
# a shared deck. It lives in the private work vault; merge_into_linked.py takes it as an
# argument, so nothing here needs a copy.
*HourlyPowerData 3*
_upslide-template/
_tools/upslide/
